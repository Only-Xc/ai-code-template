{
  "name": "@template/nestjs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:root": "tsc -b --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1",
