    "deploy:build": "tsx scripts/deploy.ts build",
    "deploy:up": "tsx scripts/deploy.ts up",
    "deploy:down": "tsx scripts/deploy.ts down",
    "deploy:restart": "tsx scripts/deploy.ts restart",
    "deploy:logs": "tsx scripts/deploy.ts logs",
    "deploy:status": "tsx scripts/deploy.ts status",
    "deploy:migrate": "tsx scripts/deploy.ts migrate",
    "deploy:pull": "tsx scripts/deploy.ts pull",
    "dev:compose-up": "tsx scripts/dev.ts compose-up",
    "dev:compose-down": "tsx scripts/dev.ts compose-down",
    "dev:compose-logs": "tsx scripts/dev.ts compose-logs",
    "dev:api": "tsx scripts/dev.ts api",
    "dev:migrate": "tsx scripts/dev.ts migrate",
    "verify": "tsx scripts/verify.ts --fast",
    "verify:full": "tsx scripts/verify.ts --full"
